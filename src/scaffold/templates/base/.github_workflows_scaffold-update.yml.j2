name: Scaffold update

on:
  schedule:
    - cron: "0 7 * * 1"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  scaffold-update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v5

      - name: Upgrade scaffold-managed files
        run: uvx scaffold@latest upgrade

      - name: Open or update PR
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw +%}
        run: |
          if git diff --quiet; then
            echo "Already up to date with scaffold"
            exit 0
          fi
          branch="chore/scaffold-update"
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git checkout -b "$branch"
          git commit -am "chore: update scaffold-managed files"
          git push -f origin "$branch"
          if ! gh pr view "$branch" >/dev/null 2>&1; then
            gh pr create --base main --head "$branch" \
              --title "chore: update scaffold-managed files" \
              --body "Automated \`scaffold upgrade\` to the latest templates."
          fi
